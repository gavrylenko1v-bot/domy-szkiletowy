# Set canonical origin to deployed HTTPS URL. Keep no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable indexing only after real company data, legal review and media review.
SITE_PUBLISHED=false
# Configure a verified sending domain and the actual destination. Never commit real values.
RESEND_API_KEY=
LEADS_FROM_EMAIL=
LEADS_TO_EMAIL=
# Required in production. HTTPS REST endpoint and token from Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only behind a reverse proxy that overwrites untrusted X-Forwarded-For.
TRUST_PROXY=false
